#!/usr/bin/env python3

import sys
import re
from pathlib import Path

def open_song_file(filename):
    with open(filename, "rb") as f:
        data = f.read()

    if data.startswith((b"\xff\xfe", b"\xfe\xff")):
        return data.decode("utf-16")

    return data.decode("utf-8-sig")


def process_file(filename):
    lines = open_song_file(filename).splitlines()

    # Use the filename (without its extension) as the title.
    title = Path(filename).stem
    print(f"# {title}")

    # Skip the preamble. The first blank line marks the start of the song.
    try:
        start = next(i for i, line in enumerate(lines) if not line.strip()) + 1
    except StopIteration:
        return

    for line in lines[start:]:
        # Any bare directive ending in a colon:
        # verse 1: -> ## Verse 1
        # chorus:  -> ## Chorus
        # bridge:  -> ## Bridge
        # tag:     -> ## Tag
        match = re.match(r"^(.+?):\s*$", line)
        if match:
            heading = match.group(1).strip()
            print(f"## {heading.title()}")
            continue

        # Ignore all other ChordPro directives
        if line.startswith("{") and line.endswith("}"):
            continue

        # Remove chords
        line = re.sub(r"\[[^\]]+\]", "", line)

        # Print lyric lines with an explicit HTML line break.
        if line.strip():
            print(f"{line.strip()}<br>")
        else:
            print()

    # Separate songs
    print()
    print()


def main():
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} FILE...", file=sys.stderr)
        sys.exit(1)

    for filename in sys.argv[1:]:
        process_file(filename)


if __name__ == "__main__":
    main()

